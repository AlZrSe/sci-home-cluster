# Copy to .env in this directory and fill in your Grafana Cloud values.

# Grafana Cloud OTLP gateway endpoint, e.g.
#   https://otlp-gateway-prod-us-east-0.grafana.net/otlp
GRAFANA_OTLP_ENDPOINT=

# Base64 of "instanceId:apiToken" (Grafana Cloud -> Access Policies -> token).
# Generate with: printf '%s' 'INSTANCE_ID:API_TOKEN' | base64
GRAFANA_OTLP_AUTH=
