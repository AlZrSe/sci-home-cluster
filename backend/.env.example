# Scientific Home Cluster Backend Environment Variables

# API Settings
API_V1_STR=/api/v1
PROJECT_NAME=Scientific Home Cluster API
VERSION=1.0.0

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=11520  # 8 days

# Syncthing
SYNCTHING_ROOT=/path/to/your/syncthing/folder

# Database
DATABASE_URL=sqlite:///./scientific_home_cluster.db

# CORS Origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Logging
LOG_LEVEL=INFO