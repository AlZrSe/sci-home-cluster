# Backend environment configuration.
#
# Copy to `.env` to use it. This file did not exist before issue #34, so
# DATABASE_URL was previously documented only in prose in README.md and
# docs/backend-setup-spec.md.
#
# PRECEDENCE, highest first:
#   1. the process environment
#   2. `<repo-root>/.env`  <- discovery is REPO-ROOT-ANCHORED
#   3. the defaults below
#
# Note step 2: pydantic-settings loads `env_file` from the repository root
# (where this file lives), not the current working directory. This means
# launching from `backend/` or any subdirectory still picks up the repo-root
# `.env`. An explicit `ENV_FILE` environment variable still wins if set.

# --- Database -----------------------------------------------------------
#
# Unset by default means: an ABSOLUTE path under the repository root,
#   <repo-root>/data/scientific_home_cluster.db
# which is identical from every working directory. The directory is created
# lazily, on first connect - importing the package creates nothing.
#
# Set this to point at a database elsewhere (e.g. a Syncthing volume). An
# absolute path is strongly preferred: a relative one is resolved against the
# working directory, so two launch directories mean two different databases.
# A relative value still works and is only warned about, never rejected.
# DATABASE_URL=sqlite:////absolute/path/to/scientific_home_cluster.db
# DATABASE_URL=sqlite:///./relative.db

# --- Local server state -------------------------------------------------
#
# Holds the generated JWT signing key, so tokens survive a restart. Unset means
# <repo-root>/.shc (absolute, CWD-independent). Previously the default was the
# literal ".shc", so the key was written into whatever directory the process
# was launched from.
#
# The key is GENERATED on first use and is NEVER committed - `.shc/` is in
# .gitignore at any depth. Two signing keys were committed here before that
# rule existed and are still in git history, so the first start after upgrading
# past issue #56 replaces a key on the deny-list and logs a WARNING, which
# invalidates every token issued before it. See README.md "Where is the
# signing key?".
#
# SHC_STATE_DIR can be set in .env or the environment. The value is used
# verbatim (relative or absolute). Unset falls back to <repo-root>/.shc.
# SHC_STATE_DIR=/absolute/path/to/.shc

# --- Syncthing shared folder --------------------------------------------
#
# The folder Syncthing replicates between the server and every compute node.
# Required on all nodes (AGENTS.md, "Environment & Auth"); the agent has no
# default for it by design.
#
# This is the HOST path. `docker compose up` bind-mounts it into the backend
# container at /tmp/syncthing. The agent, run on each node, uses that node's own
# copy of this path directly.
#
# The default below is ./syncthing - a folder inside this checkout, created by
# `python docker/init_env.py`. Compose resolves a relative bind source against
# the project directory, so it means the same thing on every machine and needs
# no per-host editing. Point it at a real Syncthing folder for a deployment:
#
#     Windows:  SYNCTHING_ROOT=D:\syncthing-shared
#     Linux:    SYNCTHING_ROOT=/mnt/syncthing-shared
#
# Why the default is a real folder rather than nothing at all: unmounted, the
# backend creates an empty /tmp/syncthing itself, reports the cluster available
# because the directory it just made exists, and no node ever claims a submitted
# job. A project-local default that you can see in `ls` is far harder to get
# wrong than a required absolute path (issue #104).
#
# It is gitignored (/syncthing/) and excluded from the Docker build context, so
# the jobs and node records in it are never committed and never shipped in an
# image.
SYNCTHING_ROOT=./syncthing

# --- Docker Compose -----------------------------------------------------
#
# `docker compose up -d` needs TWO variables set in this file:
#
#     SHARED_TOKEN   the bearer token (below)
#     SYNCTHING_ROOT the Syncthing folder (above)
#
# Compose reads both from this file automatically - no `env_file:` key is
# involved - and stops with exit 1 and a one-line message naming whichever is
# missing or empty, before it creates anything. Note that `:?` also rejects an
# EMPTY value, so uncomment SHARED_TOKEN below rather than leaving it as
# `SHARED_TOKEN=`.
#
# `.env` is gitignored and .dockerignore keeps it out of the build context, so
# the token here is never committed and never baked into an image.

# --- Tokens -------------------------------------------------------------
#
# RECOMMENDED, and required to mint a token over the API: POST
# /api/v1/auth/token exchanges this for a short-lived JWT. It is NOT
# auto-generated - it is None until you set it here, and the endpoint answers
# SHARED_TOKEN_NOT_CONFIGURED until you do (issue #56).
#
# Set it if the cluster is reachable from outside your LAN. The localhost
# bypass is a developer convenience keyed on the client-supplied Host header,
# not a security boundary.
#
# Under `docker compose` this is MANDATORY, not merely recommended: compose
# refuses to interpolate an unset or empty value and stops with exit 1 rather
# than handing the container a token-less environment (see "Docker Compose"
# above).
# SHARED_TOKEN=choose-something-long-and-random

# The signing key itself, if you want to own it rather than let one be
# generated. An explicit SECRET_KEY wins, is never persisted to .shc/, and is
# never rotated.
# SECRET_KEY=

# --- Demo data ----------------------------------------------------------
#
# false (default): a fresh database starts empty, and metrics/logs are never
# invented on read. true: seeds the 10 demo jobs / 4 demo nodes on first use.
# SEED_DEMO_DATA=true