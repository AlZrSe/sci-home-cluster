# .env.example
#
# Sample environment configuration for the Scientific Home Cluster.
#
# Copy to `.env` (repository root) to use. Values here are SAMPLES/defaults;
# uncomment and adjust as needed. Precedence, highest first:
#   1. the process environment
#   2. `<repo-root>/.env`  (repo-root-anchored, see backend/core/config.py)
#   3. the defaults baked into the code
#
# Sections:
#   - Backend (FastAPI API server)
#   - Agent    (worker node agent)
#
# Variables consumed by the frontend build (VITE_*) and by Docker are listed
# at the end for completeness; they are not read from this file by the backend.

# ===========================================================================
# BACKEND
# ===========================================================================

# --- API / application -----------------------------------------------------
# API_V1_STR=/api/v1
# PROJECT_NAME=Scientific Home Cluster API
# VERSION=0.1.0
# ENVIRONMENT=development        # development | test | production (also APP_ENV, DEPLOYMENT_ENVIRONMENT, ...)
# APP_VERSION=                   # service.version for OpenTelemetry (also VERSION, DEPLOYED_VERSION, ...)
# LOG_LEVEL=INFO

# --- Database --------------------------------------------------------------
# Unset => <repo-root>/data/scientific_home_cluster.db (CWD-independent).
# Default (relative, resolves to <repo-root>/data/scientific_home_cluster.db when run from repo root):
# DATABASE_URL=sqlite:///./data/scientific_home_cluster.db
# DATABASE_URL=sqlite:////absolute/path/to/scientific_home_cluster.db
# DATABASE_URL=sqlite:///./relative.db
# DB_POOL=pooled                 # pooled | null (null = fresh connection per session; tests only)
# SHC_DATA_DIR=                  # host-mounted data dir; redirects DATABASE_URL when still default

# --- Local server state ----------------------------------------------------
# Holds the generated JWT signing key, shared token file, cookie secret.
# Unset => <repo-root>/.shc (absolute, CWD-independent).
# SHC_STATE_DIR=/absolute/path/to/.shc

# --- Security / auth -------------------------------------------------------
# SECRET_KEY=                    # JWT signing key; generated & persisted if unset
# ACCESS_TOKEN_EXPIRE_MINUTES=1440
# SHARED_TOKEN=                  # shared bearer token; generated & persisted if unset
# AUTH_COOKIE_SECRET=            # cookie signing key; generated & persisted if unset
# AUTH_COOKIE_NAME=shc_token
# AUTH_COOKIE_MAX_AGE_SECONDS=86400
# AUTH_COOKIE_SECURE=true
# AUTH_COOKIE_SAME_SITE=strict   # strict | lax | none
# AUTH_WS_TICKET_TTL_SECONDS=300

# --- Auth rate limiting ----------------------------------------------------
# AUTH_RATE_LIMIT_BASE=5
# AUTH_RATE_LIMIT_WINDOW_SECONDS=900
# AUTH_RATE_LIMIT_BACKOFF_BASE_SECONDS=2
# AUTH_RATE_LIMIT_MAX_BACKOFF_SECONDS=3600
# AUTH_RATE_LIMIT_LOCKOUT_THRESHOLD=11
# AUTH_RATE_LIMIT_LOCKOUT_SECONDS=3600

# --- Syncthing (shared folder) --------------------------------------------
# Host path to the Syncthing shared folder. Required on every node.
# Default in this checkout: ./syncthing
SYNCTHING_ROOT=./syncthing
# SYNCTHING_GUI_HOST=127.0.0.1
# SYNCTHING_GUI_PORT=8384

# --- CORS ------------------------------------------------------------------
# BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
# ENABLE_LOVABLE_PREVIEW_CORS=false

# --- Frontend serving (container image) -----------------------------------
# SERVE_FRONTEND=false
# FRONTEND_DIR=/absolute/path/to/frontend/.output/public

# --- Localhost auth bypass (dev convenience, not a security boundary) -------
# LOCALHOST_BYPASS=true
# LOCALHOST_BYPASS_MODE=         # disabled | socket | host_header

# --- Heartbeat contract ----------------------------------------------------
# HEARTBEAT_TIMEOUT_SECONDS=90
# HEARTBEAT_CHECK_INTERVAL_SECONDS=30

# --- CSP / API docs --------------------------------------------------------
# CSP_POLICY=default-src 'self'; ...
# CSP_REPORT_ONLY=false
# ENABLE_API_DOCS=false           # auto-enabled when ENVIRONMENT=development|test

# --- Demo data -------------------------------------------------------------
# SEED_DEMO_DATA=false           # seed 10 demo jobs / 4 demo nodes on first use

# --- OpenTelemetry / observability ----------------------------------------
# Canonical names (aliases in parentheses are also accepted by telemetry.py):
#   OTEL_SERVICE_NAME (SERVICE_NAME, APP_NAME, APPLICATION_NAME)
#   ENVIRONMENT (APP_ENV, APP_ENVIRONMENT, DEPLOYMENT_ENVIRONMENT, DEPLOY_ENV, OTEL_ENVIRONMENT, ENV, STAGE, NODE_ENV)
#   APP_VERSION (VERSION, DEPLOYED_VERSION, SERVICE_VERSION, OTEL_SERVICE_VERSION, RELEASE_VERSION, BUILD_VERSION)
# OTEL_SERVICE_NAME=
# OTEL_EXPORTER_OTLP_ENDPOINT=   # also OTEL_EXPORTER_OTLP_TRACES_ENDPOINT
# OTEL_ENABLED=true
# OTEL_SDK_DISABLED=false
# OTEL_TRACES_EXPORTER=          # console to print spans

# --- Shared file ops (atomic writes) --------------------------------------
# SHC_ATOMIC_WRITE_MAX_ATTEMPTS=5
# SHC_ATOMIC_WRITE_BASE_DELAY_MS=50
# SHC_ATOMIC_WRITE_MAX_DELAY_MS=500

# ===========================================================================
# AGENT (worker node)
# ===========================================================================
# The agent reads these from the process environment (or CLI flags). NODE_ID and
# SYNCTHING_ROOT have no defaults and are required. Everything else is optional.
# AGENT_* names are the environment variable names; the keys in nodes/agent.toml
# use the unprefixed field names (LOG_LEVEL, SHELL, ...).

# NODE_ID=node-01                # required; must match ^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$
# SYNCTHING_ROOT=/var/lib/sci-home-cluster/syncthing   # required (also --syncthing-root)
# AGENT_LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR | CRITICAL
# AGENT_SHELL=auto               # auto | sh | dash | bash | cmd | pwsh | powershell | path
# AGENT_SHUTDOWN_GRACE_S=30.0
# AGENT_FOLDER_WATCH_INTERVAL_S=30.0
# AGENT_FOLDER_RETRY_MAX_S=60.0
# AGENT_WATCHER_LIVENESS_INTERVAL_S=60.0
# AGENT_HEARTBEAT_INTERVAL_S=22.0
# AGENT_HEARTBEAT_JITTER_S=2.0
# AGENT_STATE_DIR=               # default <SYNCTHING_ROOT>/.agent/<NODE_ID>

# ===========================================================================
# FRONTEND (build-time, Vite)
# ===========================================================================
# VITE_CLUSTER_BACKEND=http      # exact string "mock" selects mockService; unset/other => httpService
# VITE_API_URL=http://localhost:8000/api/v1

# ===========================================================================
# DOCKER / RUNTIME
# ===========================================================================
# PORT=8000
# SYNCTHING_HOME=/app/data/syncthing
# SYNCTHING_AUTO_ACCEPT_FOLDERS=false
