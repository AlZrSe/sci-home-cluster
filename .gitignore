*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# MySQL
mysql/

# SQLite
*.sqlite3
# WAL sidecars: `*.db` does not match these, so they showed up as
# untracked noise next to the development database.
*.db-shm
*.db-wal

# Uploaded files
uploads/
syncthing/

# Backup files
*.bak
*.tmp

# Node modules (for frontend)
node_modules/
frontend/node_modules/

# Build outputs
frontend/dist/
frontend/build/

# Environment variables
.env.local
.env.development
.env.production
.env.test

# Canonical database location (backend/core/config.py DEFAULT_DATABASE_URL).
# The *.db / *.db-shm / *.db-wal rules below already ignore the files
# themselves; this keeps the whole directory out of `git status` even if the
# database is ever moved or renamed (issue #34).
data/

# Locally persisted server state (SHC_STATE_DIR), which holds the generated
# JWT signing key. Directory form and unanchored so it matches at any depth,
# which also covers the pre-#34 backend/.shc/. Two signing keys were
# committed here before this rule existed and are in public git history, so the
# deny-list in backend/core/config.py rotates them on next start - but the rule
# is the actual fix: nothing generated at import time belongs in the index
# (issue #56).
.shc/

# Misc
*.pyc
*.pyo
*.pyd
*.db
*.shelve
*.pickle
*.pickle3

test_venv/
test_venv2/
